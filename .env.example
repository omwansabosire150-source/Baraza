# Postgres connection string.
# Local: postgresql://postgres:postgres@localhost:5432/baraza
# Hosted free options: Neon (neon.tech) or Supabase (supabase.com)
DATABASE_URL="postgresql://user:password@localhost:5432/baraza"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (test mode) — get this from https://dashboard.stripe.com/test/apikeys
# Starts with sk_test_...
STRIPE_SECRET_KEY=""
