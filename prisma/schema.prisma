generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  MERCHANT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(BUYER)
  createdAt     DateTime  @default(now())
  store         Store?
  cart          Cart?
  orders        Order[]
}

// A Store is a merchant's branded presence inside the marketplace.
// One user owns one store in this MVP; can become many-to-many later
// (e.g. staff accounts) without breaking this model.
model Store {
  id              String   @id @default(cuid())
  owner           User     @relation(fields: [ownerId], references: [id])
  ownerId         String   @unique

  name            String
  slug            String   @unique
  category        String
  description     String?  @db.Text

  logoUrl         String?
  bannerUrl       String?
  brandColor      String   @default("#1F6F5C")

  country         String
  city            String?

  returnPolicy    String?  @db.Text
  deliveryMethods String?  @db.Text

  // Placeholder for future Stripe Connect / escrow-style payouts.
  // Null until the merchant completes onboarding with the payment provider.
  stripeAccountId String?
  stripeOnboardingComplete Boolean @default(false)

  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products        Product[]
  orders          Order[]
}

model Product {
  id           String   @id @default(cuid())
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId      String

  name         String
  slug         String
  description  String?  @db.Text
  imageUrl     String?

  priceCents   Int
  currency     String   @default("USD")

  sku          String?
  stockQty     Int      @default(0)
  condition    String   @default("new")

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId])
}

// One cart per buyer. Items can come from multiple stores; checkout splits
// them into one Order per store, since each store settles independently.
model Cart {
  id       String     @id @default(cuid())
  buyer    User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId  String     @unique
  items    CartItem[]
  updatedAt DateTime  @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int      @default(1)

  @@unique([cartId, productId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// One Order per store per checkout. Payment is not wired up yet (Phase 3):
// orders are created as PENDING_PAYMENT so the shape is ready for Stripe
// Connect's hold-and-release flow to slot in without a schema change.
model Order {
  id               String      @id @default(cuid())
  buyer            User        @relation(fields: [buyerId], references: [id])
  buyerId          String
  store            Store       @relation(fields: [storeId], references: [id])
  storeId          String

  status           OrderStatus @default(PENDING_PAYMENT)
  totalCents       Int
  currency         String      @default("USD")

  shippingName     String
  shippingPhone    String?
  shippingAddress  String
  shippingCity     String?
  shippingCountry  String

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Stripe: buyer's payment (captured to the platform account, not the merchant).
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?

  // Stripe: the eventual payout to the merchant, made on delivery confirmation.
  platformFeeCents  Int?
  stripeTransferId  String?

  items            OrderItem[]

  @@index([buyerId])
  @@index([storeId])
  @@index([stripeCheckoutSessionId])
}

model OrderItem {
  id                 String  @id @default(cuid())
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId            String
  product            Product @relation(fields: [productId], references: [id])
  productId          String

  // Snapshotted at purchase time so later product edits don't rewrite history.
  nameSnapshot       String
  priceCentsSnapshot Int
  quantity           Int

  @@index([orderId])
}
